{
  "name": "@alexgsdev/claude-ai-transcript-export",
  "version": "0.1.0",
  "description": "Extract selected conversations from a claude.ai account export into readable, committable markdown transcripts.",
  "keywords": [
    "claude",
    "claude-ai",
    "transcript",
    "export"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexgs/claude-ai-transcript-export.git"
  },
  "homepage": "https://github.com/alexgs/claude-ai-transcript-export#readme",
  "bugs": {
    "url": "https://github.com/alexgs/claude-ai-transcript-export/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "caitx": "dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "npm run build",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only"
  },
  "dependencies": {
    "@alexgsdev/claude-code-transcript-export": "^0.2.0",
    "fflate": "^0.8.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@types/node": "^22.10.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "volta": {
    "node": "22.23.2",
    "npm": "11.5.2"
  }
}
